<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:FortnitePorting.ViewModels"
             xmlns:ext="clr-namespace:FortnitePorting.Extensions"
             x:Class="FortnitePorting.Views.ShadersView"
             x:DataType="viewModels:ShadersViewModel">
    <Grid Margin="{ext:Space 2}" RowDefinitions="Auto,8,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Text="Converted shaders" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
        </Grid>

        <TextBlock Grid.Row="2" Text="Nothing converted yet." Opacity="0.6" HorizontalAlignment="Center"
                   Margin="0,24,0,0" IsVisible="{Binding IsEmpty}" />

        <ScrollViewer Grid.Row="2" IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Shaders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ShaderRow">
                        <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Meta}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Check" Classes="accent"
                                        Command="{Binding $parent[ItemsControl].((viewModels:ShadersViewModel)DataContext).CheckCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="2" Content="Folder"
                                        Command="{Binding $parent[ItemsControl].((viewModels:ShadersViewModel)DataContext).OpenFolderCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="3" Content="Cache"
                                        Command="{Binding $parent[ItemsControl].((viewModels:ShadersViewModel)DataContext).OpenCacheCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
