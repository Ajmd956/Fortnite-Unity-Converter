<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FortnitePorting.ViewModels"
             xmlns:ext="clr-namespace:FortnitePorting.Extensions"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="550"
             x:Class="FortnitePorting.Views.ConvertView"
             x:DataType="viewModels:ConvertViewModel">
    <Grid Margin="{ext:Space 1}" RowDefinitions="Auto,8,Auto,8,*" ColumnDefinitions="300,8,*">
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
            <Button Content="Convert" Classes="accent" Command="{Binding ConvertCommand}" />
            <Button Content="Stop" IsEnabled="{Binding IsRunning}" Command="{Binding StopCommand}" />
            <Button Content="Clear Queue" Command="{Binding ClearQueueCommand}" />
            <Button Content="Open Conversions Folder" Command="{Binding OpenConversionsFolderCommand}" />
            <Button Content="Open Cache Folder" Command="{Binding OpenCacheFolderCommand}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" RowDefinitions="Auto,Auto,Auto">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="Material Paths" FontWeight="SemiBold" />
                    <TextBlock Text="One per line. Copy them from the Files tab, or paste any material path." Opacity="0.7" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Content="Paste" Command="{Binding PasteMaterialsCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Clear" Command="{Binding ClearMaterialsCommand}" />
            </Grid>
            <TextBox Grid.Row="1" Text="{Binding MaterialPaths}" AcceptsReturn="True" TextWrapping="NoWrap" Height="90"
                     Watermark="/Game/.../MI_Example.MI_Example" FontFamily="Consolas,Menlo,monospace" />
            <TextBox Grid.Row="2" Text="{Binding ShaderName}" Margin="0,4,0,0"
                     Watermark="Shader name (optional, only used when converting one material)" />
        </Grid>

        <Grid Grid.Row="4" Grid.Column="0" RowDefinitions="Auto,*,8,Auto,*">
            <TextBlock Grid.Row="0" Text="Queue" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Queue}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Remove" Padding="6,2"
                                    Command="{Binding $parent[ListBox].((viewModels:ConvertViewModel)DataContext).RemoveFromQueueCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="3" Text="Converted" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ListBox Grid.Row="4" ItemsSource="{Binding Converted}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:ConvertedShader">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="Open shader" Padding="6,2"
                                    Command="{Binding $parent[ListBox].((viewModels:ConvertViewModel)DataContext).OpenShaderCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="4" Grid.Column="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock Text="Output" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Clear" Padding="6,2" Command="{Binding ClearOutputCommand}" />
            </Grid>
            <TextBox Grid.Row="1" Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas,Menlo,monospace" />
        </Grid>
    </Grid>
</UserControl>
